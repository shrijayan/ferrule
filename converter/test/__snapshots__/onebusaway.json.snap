    "/api/where/report-problem-with-stop/{stopID}.json": {
      "get": {
        "operationId": "reportProblemWithStop",
        "parameters": [
          {
            "description": "The ID of the stop",
            "in": "path",
            "name": "stopID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "A string code identifying the nature of the problem",
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "enum": [
                "stop_name_wrong",
                "stop_number_wrong",
                "stop_location_wrong",
                "route_or_trip_missing",
                "other"
              ],
              "type": "string"
            }
          },
          {
            "description": "Additional comment text supplied by the user describing the problem",
            "in": "query",
            "name": "userComment",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The reporting user’s current latitude",
            "in": "query",
            "name": "userLat",
            "required": false,
            "schema": {
              "format": "float",
              "type": "number"
            }
          },
          {
            "description": "The reporting user’s current longitude",
            "in": "query",
            "name": "userLon",
            "required": false,
            "schema": {
              "format": "float",
              "type": "number"
            }
          },
          {
            "description": "The reporting user’s location accuracy, in meters",
            "in": "query",
            "name": "userLocationAccuracy",
            "required": false,
            "schema": {
              "format": "float",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseWrapper"
                }
              }
            },
            "description": "Problem report successfully submitted"
          }
        },
        "summary": "Submit a user-generated problem report for a stop",
        "x-fern-sdk-group-name": [
          "report_problem_with_stop"
        ],
        "x-fern-sdk-method-name": "retrieve",
        "x-ferrule-method-name": "retrieve",
        "x-ferrule-models": {
          "Reference": {
            "module": "shared.references",
            "name": "References"
          },
          "ResponseWrapper": {
            "module": "shared.response_wrapper",
            "name": "ResponseWrapper"
          }
        },
        "x-ferrule-package": {
          "name": "onebusaway",
          "repo": "OneBusAway/python-sdk"
        },
        "x-ferrule-resource": {
          "path": [
            "report_problem_with_stop"
          ]
        }
      }
    },
