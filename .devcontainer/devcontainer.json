{
  "name": "ferrule",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers-extra/features/mise:1": {}
  },
  "containerEnv": {
    "MISE_YES": "1"
  },
  "postCreateCommand": "mise trust && mise install && mise run install && (test -f scripts/forge-setup.sh && mise run forge:setup || true) && lefthook install",
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-pyright.pyright",
        "hverlin.mise-vscode"
      ]
    }
  }
}
