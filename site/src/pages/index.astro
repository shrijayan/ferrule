// Landing page. Code samples are highlighted and the fidelity board is built at build time;
// src/scripts/landing.ts only runs the animations.
import '../styles/landing.css';
import fidelity from '../data/fidelity.json';
// biome-ignore lint/correctness/noUnusedImports: LOGOS is used by the template below
import { LOGOS, type Logo } from '../data/logos';
import currentTime from '../data/onebusaway-current-time.py.txt?raw';
import { highlightPython, highlightYaml } from '../lib/highlight';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// biome-ignore lint/correctness/noUnusedVariables: used by the template below
const docs = `${base}/docs/`;
// biome-ignore lint/correctness/noUnusedVariables: used by the template below
const repo = 'https://github.com/shrijayan/ferrule';
const site = Astro.site?.href.replace(/\/$/, '') ?? '';
const install = `curl -LsSf ${site}/install.sh | sh`;

// What the hero's "Copy agent prompt" puts on the clipboard: pasted into a coding agent in the
// user's project, it reads the docs and does the setup the install command starts.
// biome-ignore lint/correctness/noUnusedVariables: used by the template below
const agentPrompt = `Set up Ferrule in this project so it generates our SDK from our OpenAPI spec.

1. Read ${site}/llms.txt and the docs it links to. The quickstart is the source of truth; follow it over anything here.
2. Install the generator with \`${install}\`. For a Python SDK, also install ruff if it is missing.
3. Find our OpenAPI spec (OpenAPI 3.x or Swagger 2.0, YAML or JSON) and our stainless.yml. If there is no stainless.yml, stop and ask me.
4. If this repository is an SDK Stainless generated, follow the quickstart's adopt steps and show me the verify report before you change anything. Otherwise run \`ferrule-gen generate --spec <spec> --config <stainless.yml> --out <dir>\`.
5. If a command fails with a FER error, apply the fix it suggests and run it again.

When you are done, tell me the commands you ran, what was generated and where, and anything you could not resolve.`;

// Formats the converter reads, and the SDK languages the plugins write.
// biome-ignore lint/correctness/noUnusedVariables: used by the template below
const inputs: [Logo, string][] = [
  ['openapi', 'OpenAPI 3.x'],
  ['swagger', 'Swagger 2.0'],
  ['yaml', 'stainless.yml'],
];
// biome-ignore lint/correctness/noUnusedVariables: used by the template below
const outputs: [Logo, string][] = [
  ['python', 'Python'],
  ['typescript', 'TypeScript'],
  ['go', 'Go'],
  ['java', 'Java'],
  ['kotlin', 'Kotlin'],
  ['ruby', 'Ruby'],
  ['php', 'PHP'],
  ['csharp', 'C#'],
  ['rust', 'Rust'],
];

// Real OneBusAway config (OneBusAway/sdk-config) and README usage (OneBusAway/python-sdk).
// biome-ignore lint/correctness/noUnusedVariables: used by the template below
const heroYaml = highlightYaml(`organization:
  name: onebusaway-sdk
  contact: info@onebusaway.org

resources:
  current_time:
    methods:
      retrieve: get /api/where/current-time.json
  agency:
    methods:
      retrieve: get /api/where/agency/{agencyID}.json`).join('\n');
// biome-ignore lint/correctness/noUnusedVariables: used by the template below
const heroPy = highlightPython(`from onebusaway import OnebusawaySDK

client = OnebusawaySDK()

now = client.current_time.retrieve()
agency = client.agency.retrieve("1")

# names come from the config.
# this is what users import.`).join('\n');

// biome-ignore lint/correctness/noUnusedVariables: used by the template below
const agentTree = [
  'onebusaway/_agent/',
  '├── <b>SKILL.md</b>',
  '├── <b>AGENTS.md</b>',
  '└── <b>llms.txt</b>',
  'examples/agent/   # tested recipes',
].join('\n');

// The only difference between the two files is the generator named in the header.
const stainlessFile = currentTime.trimEnd();
const ferruleFile = stainlessFile.replace('by Stainless.', 'by Ferrule.');
// biome-ignore lint/correctness/noUnusedVariables: used by the template below
const diffA = highlightPython(stainlessFile);
// biome-ignore lint/correctness/noUnusedVariables: used by the template below
const diffB = highlightPython(ferruleFile);

// Stacked rings make the machined collar; two are darker to read as crimp grooves.
const RING_LAYERS = 18;
// biome-ignore lint/correctness/noUnusedVariables: used by the template below
const ringLayers = Array.from({ length: RING_LAYERS }, (_, i) => {
  const z = (i - (RING_LAYERS - 1) / 2) * 2.1;
  const edge = i === 0 || i === RING_LAYERS - 1;
  const groove = i === 5 || i === 12;
  const b = edge ? 1.12 : groove ? 0.42 : 0.72 + Math.sin((i / (RING_LAYERS - 1)) * Math.PI) * 0.12;
  return `--z:${z.toFixed(2)}px;--b:${b.toFixed(2)}`;
});

// Flow lines from the config card, through the collar, to the code card (viewBox 1200 x 470).
const FLOW_LEFT = 406;
const FLOW_RIGHT = 794;
const FLOW_CX = 600;
const FLOW_CY = 245;
// biome-ignore lint/correctness/noUnusedVariables: used by the template below
const flows = [120, 165, 210, 255, 300, 345, 390].map((y, k) => {
  const mid = FLOW_CY + (k - 3) * 9;
  const out = 120 + k * 45;
  return {
    d: `M${FLOW_LEFT},${y} C${FLOW_LEFT + 110},${y} ${FLOW_CX - 120},${mid} ${FLOW_CX},${mid} C${FLOW_CX + 120},${mid} ${FLOW_RIGHT - 110},${out} ${FLOW_RIGHT},${out}`,
    style: `--d:${(3.6 + (k % 3) * 0.7).toFixed(1)}s;--delay:${(-k * 0.9).toFixed(1)}s`,
    start: y,
    end: out,
  };
});

// Status per language: every SDK language is on main. Proof is identical files out of the
// total, against real public Stainless SDKs.
interface LangRow {
  name: string;
  status: 'main' | 'none';
  best: [number, number] | null;
  proof: string;
  plugin: string | null;
}
// biome-ignore lint/correctness/noUnusedVariables: used by the template below
const languages: LangRow[] = [
  {
    name: 'Python',
    status: 'main',
    best: [80, 80],
    proof:
      'onebusaway: 0 breaking, 1,110 of its own tests pass. Five real SDKs adopt with 0 breaking, every test passing and custom code unchanged.',
    plugin: 'python-plugin',
  },
  {
    name: 'TypeScript',
    status: 'main',
    best: [84, 84],
    proof:
      'isaacus-typescript, and its lint and 216 jest tests pass. onebusaway-typescript (node layout) 108/109.',
    plugin: 'ts-plugin',
  },
  {
    name: 'Go',
    status: 'main',
    best: [65, 69],
    proof:
      'onebusaway-go: runtime 25/25, builds and tests pass. v2 layout, imagekit-go: runtime 54/54, generated 17/45.',
    plugin: 'go-plugin',
  },
  {
    name: 'Java',
    status: 'main',
    best: [328, 343],
    proof: 'onebusaway-java. imagekit-java 186/291.',
    plugin: 'jvm-plugin',
  },
  {
    name: 'Kotlin',
    status: 'main',
    best: [282, 338],
    proof: 'onebusaway-kotlin.',
    plugin: 'jvm-plugin',
  },
  {
    name: 'Ruby',
    status: 'main',
    best: [326, 329],
    proof: "onebusaway-ruby. imagekit-ruby 349/432. Both gems' own tests pass.",
    plugin: 'ruby-plugin',
  },
  {
    name: 'PHP',
    status: 'main',
    best: [271, 340],
    proof:
      "imagekit-php, shared files: runtime 48/48 (319/388 with it; 82 more under other names), and the package's 87 pest tests pass.",
    plugin: 'php-plugin',
  },
  {
    name: 'C#',
    status: 'main',
    best: [109, 184],
    proof:
      "imagekit-dotnet: runtime 38/38, 38 more files differ only in doc wrapping, builds with dotnet. The synthetic SDK's 89 tests pass.",
    plugin: 'csharp-plugin',
  },
  {
    name: 'CLI, Terraform',
    status: 'none',
    best: null,
    proof:
      'No public Stainless-generated CLI or provider pairs with a public config, so there is no oracle to prove against.',
    plugin: null,
  },
];
// biome-ignore lint/correctness/noUnusedVariables: used by the template below
const statusLabel = { main: 'on main', none: 'not started' } as const;

interface BoardRow {
  name: string;
  repo: string | null;
  breaking: number;
  additive: number;
  closeness: number | null;
  tests_passed: number;
  tests_failed: number;
  tests_status: string;
  generated: string | null;
}

const board = [...(fidelity as BoardRow[])].sort(
  (a, b) => a.breaking - b.breaking || (b.closeness ?? 0) - (a.closeness ?? 0),
);
// biome-ignore lint/correctness/noUnusedVariables: used by the template below
const boardDate = board
  .map((r) => r.generated)
  .filter((g): g is string => g !== null)
  .sort()
  .at(-1);
// biome-ignore lint/correctness/noUnusedVariables: used by the template below
const testsLabel = (r: BoardRow): string => {
  if (r.tests_status === 'passed') return `${r.tests_passed.toLocaleString('en-US')} passed`;
  if (r.tests_status === 'failed') return `${r.tests_failed.toLocaleString('en-US')} failed`;
  return 'not run yet';
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ferrule · SDKs from your OpenAPI spec</title>
    <meta
      name="description"
      content="Ferrule generates the SDKs your users import — Python, TypeScript, Go, Java, Kotlin, Ruby, PHP and C# — from an OpenAPI spec and one config. Deterministic. One Rust binary. Apache-2.0. Runs on your laptop and in CI. No account."
    />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="nav" id="nav">
      <div class="wrap">
        <a href={`${base}/`} class="logo" aria-label="Ferrule home">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <defs>
              <linearGradient id="lg" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#f6e2b4"></stop><stop offset=".5" stop-color="#d6a660"
                ></stop><stop offset="1" stop-color="#8a5c2c"></stop>
              </linearGradient>
            </defs>
            <ellipse cx="13" cy="16" rx="6" ry="12" fill="none" stroke="url(#lg)" stroke-width="2.4"></ellipse>
            <ellipse cx="19" cy="16" rx="6" ry="12" fill="none" stroke="url(#lg)" stroke-width="2.4" opacity=".55"
            ></ellipse>
            <path d="M13 4h6M13 28h6" stroke="url(#lg)" stroke-width="2.4"></path>
          </svg>
          Ferrule
        </a>
        <nav class="nav-links">
          <a href="#why">Why</a>
          <a href="#adopt">Adopt</a>
          <a href="#languages">Languages</a>
          <a href="#how">How it works</a>
          <a href="#compare">Compare</a>
          <a href="#proof">Proof</a>
          <a href="#board">Fidelity board</a>
          <a href={docs}>Docs</a>
        </nav>
        <div class="nav-cta">
          <a class="btn" href={repo}>
            <svg aria-hidden="true" viewBox="0 0 16 16" fill="currentColor"
              ><path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path></svg
            >
            GitHub<span class="gh-stars" data-stars hidden
              ><svg class="gh-star" viewBox="0 0 16 16" aria-hidden="true"
                ><path
                  fill="currentColor"
                  d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"
                ></path></svg
              ><span class="gh-count"></span></span
            >
          </a>
          <a class="btn btn-brass" href={`${docs}quickstart/`}>Get started</a>
        </div>
      </div>
    </header>

    <section class="hero" id="top">
      <div class="wrap">
        <div class="eyebrow reveal"><span class="pill">Open source</span> Eight languages, one config</div>
        <h1 class="display reveal d1">Generate the SDKs.<br /><em>From the spec.</em></h1>
        <p class="lede reveal d2">
          Ferrule reads an OpenAPI spec and a <code>stainless.yml</code>, then writes the <strong>SDKs your users import</strong>. Deterministic, one Rust binary, Apache-2.0, on your laptop and in CI, with no account.
        </p>
        <div class="hero-actions reveal d3">
          <button type="button" class="cmd" data-copy={install} aria-label="Copy install command">
            <span class="cmd-text"><span class="p">$</span> curl -LsSf <span class="nw">{site.replace('https://', '')}/install.sh</span> <span class="nw">| sh</span></span>
            <span class="copy"
              ><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                ><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"
                ></path></svg
              ></span
            >
          </button>
          <button type="button" class="btn btn-lg btn-prompt" data-copy={agentPrompt} aria-label="Copy a setup prompt for your coding agent">
            <span class="copy"
              ><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                ><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"></path><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"></path></svg
              ></span
            >Copy agent prompt
          </button>
          <a class="btn btn-brass btn-lg" href={`${docs}quickstart/`}>Get started</a>
        </div>
        <p class="hero-note reveal d3">
          Pre-alpha · then <code>ferrule-gen generate</code> · or paste the prompt into your coding agent: it reads{' '}
          <a href="/llms.txt">llms.txt</a> and does the setup
        </p>
        <div class="hero-io reveal d3" aria-label="Inputs and outputs">
          <div class="hio-group hio-in">
            <span class="hio-label">Reads</span>
            {
              inputs.map(([logo, label]) => (
                <span class="hio-chip">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={LOGOS[logo]} /></svg>
                  {label}
                </span>
              ))
            }
          </div>
          <span class="hio-arrow" aria-hidden="true">→</span>
          <div class="hio-group hio-out">
            <span class="hio-label">Writes</span>
            {
              outputs.map(([logo, label]) => (
                <span class="hio-chip" title={label}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={LOGOS[logo]} /></svg>
                  {label}
                </span>
              ))
            }
          </div>
        </div>

        <div class="stage reveal" id="stage">
          <div class="annot a1"><b>The config</b></div>
          <div class="annot a2"><span class="tick l"></span><b>Ferrule</b><span class="tick r"></span></div>
          <div class="annot a3"><b>The SDK</b></div>

          <svg class="flow" viewBox="0 0 1200 470" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="brassStroke" x1="0" x2="1">
                <stop offset="0" stop-color="#8a5c2c" stop-opacity="0"></stop>
                <stop offset=".5" stop-color="#f6e2b4"></stop>
                <stop offset="1" stop-color="#d6a660"></stop>
              </linearGradient>
            </defs>
            {
              flows.map((f) => (
                <g>
                  <path class="base" d={f.d} />
                  <path class="pulse" d={f.d} style={f.style} />
                  <circle class="node" cx={FLOW_LEFT} cy={f.start} r="2.5" />
                  <circle class="node" cx={FLOW_RIGHT} cy={f.end} r="2.5" />
                </g>
              ))
            }
          </svg>

          <div class="ferrule back" aria-hidden="true">
            <div class="glow"></div>
            <div class="r3d">{ringLayers.map((style) => <i style={style} />)}</div>
            <div class="core"></div>
          </div>
          <div class="ferrule front" aria-hidden="true">
            <div class="r3d">{ringLayers.map((style) => <i style={style} />)}</div>
          </div>

          <div class="card left">
            <div class="card-head">
              <div class="dots"><i></i><i></i><i></i></div>
              stainless.yml<span class="tag">reads this</span>
            </div>
            <pre set:html={heroYaml} />
          </div>
          <div class="card right">
            <div class="card-head">
              <div class="dots"><i></i><i></i><i></i></div>
              app.py<span class="tag">users import</span>
            </div>
            <pre set:html={heroPy} />
          </div>
        </div>

        <div class="stage-foot reveal">
          <span>OpenAPI 3.x and stainless.yml in</span>
          <span>SDKs out, in eight languages</span>
          <span>One Rust binary, Forge built in</span>
        </div>
      </div>

      <div class="marquee">
        <div class="marquee-track">
          {
            [false, true].map((hidden) => (
              <div aria-hidden={hidden ? 'true' : undefined}>
                <div class="marquee-item">
                  <b>0</b>
                  <span>breaking changes on the OneBusAway SDK</span>
                </div>
                <div class="marquee-item">
                  <b>1,110</b>
                  <span>of its own tests pass on our output</span>
                </div>
                <div class="marquee-item">
                  <b>80 / 80</b>
                  <span>generated code files identical</span>
                </div>
                <div class="marquee-item">
                  <b>8</b>
                  <span>SDK languages, all on main</span>
                </div>
                <div class="marquee-item">
                  <b>byte-for-byte</b>
                  <span>the same output on every run</span>
                </div>
                <div class="marquee-item">
                  <b>no</b>
                  <span>account, token or telemetry</span>
                </div>
                <div class="marquee-item">
                  <b>never</b>
                  <span>a CLA</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="sec" id="why">
      <div class="wrap">
        <div class="sec-head">
          <div class="kicker reveal">Why Ferrule</div>
          <h2 class="h2 reveal d1">A spec is not an SDK. <em>Ferrule writes it.</em></h2>
          <p class="sub reveal d2">
            You maintain an OpenAPI document. Your users want a client they can import, in the languages you ship.
            One config names the client, the resources and the methods.
          </p>
        </div>
        <div class="options">
          <div class="opt reveal">
            <span class="n">Option 01</span>
            <h3>Write each SDK by hand</h3>
            <p>
              Every new endpoint is a change in every language. The clients drift apart, and the spec stops being
              the source of the code your users import.
            </p>
            <span class="verdict">The SDKs drift</span>
          </div>
          <div class="opt reveal d1">
            <span class="n">Option 02</span>
            <h3>Rent a hosted generator</h3>
            <p>
              Generation runs on someone else's service. You need an account. The licence on the code you ship
              follows their terms.
            </p>
            <span class="verdict">Their cloud, their terms</span>
          </div>
          <div class="opt win reveal d2">
            <span class="n">Option 03 · Ferrule</span>
            <h3>Generate it on your machine</h3>
            <p>
              One spec, one <code>stainless.yml</code>, an SDK per language. Deterministic output. A single Rust
              binary. No account. The SDK does not depend on Ferrule.
            </p>
            <span class="verdict">Yours, on your machine</span>
          </div>
        </div>
      </div>
    </section>

    <section class="sec flush" id="adopt">
      <div class="wrap">
        <div class="sec-head">
          <div class="kicker reveal">Moving over</div>
          <h2 class="h2 reveal d1">Already have a stainless.yml? <em>Moving over is seamless.</em></h2>
          <p class="sub reveal d2">
            It is easy. You keep the config shape. Your users' code keeps working.
            <code>ferrule adopt</code> reads that config, regenerates the SDKs, and proves the public surface before
            you commit.
          </p>
        </div>
        <ol class="next-steps reveal">
          <li>
            <span class="ns-n">01</span>
            <h4>Adopt locally</h4>
            <p>Rescue, regenerate, re-apply your edits and verify, inside a temporary worktree. Your checkout is never touched.</p>
            <code class="ns-chip">ferrule adopt .</code>
          </li>
          <li>
            <span class="ns-n">02</span>
            <h4>Review one commit</h4>
            <p>The spec, your patches, <code>ferrule.lock</code> and the workflow. Generated files differ by one header line.</p>
            <code class="ns-chip">branch ferrule/adopt</code>
          </li>
          <li>
            <span class="ns-n">03</span>
            <h4>Push and let CI test</h4>
            <p>Your existing test suite runs against the regenerated code, in your CI, like any other PR.</p>
            <code class="ns-chip">gh pr create --fill</code>
          </li>
          <li>
            <span class="ns-n">04</span>
            <h4>Merge and release</h4>
            <p>Nothing your users import has changed, so the next release is an ordinary patch.</p>
            <code class="ns-chip">release · patch</code>
          </li>
          <li>
            <span class="ns-n">05</span>
            <h4>Stay current</h4>
            <p>Every spec change opens a PR labelled major, minor or patch. A breaking change needs a human's label.</p>
            <code class="ns-chip">sdk.yml · nightly</code>
          </li>
        </ol>
        <div class="next-cta reveal">
          <a class="btn btn-brass btn-lg" href="#proof">See the proof</a>
          <a class="btn btn-lg" href={`${docs}quickstart/`}>Read the quickstart</a>
          <button type="button" class="cmd" data-copy="uvx ferrule adopt ." aria-label="Copy adopt command">
            <span class="cmd-text"><span class="p">$</span> uvx ferrule adopt .</span>
            <span class="copy"
              ><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                ><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"
                ></path></svg
              ></span
            >
          </button>
        </div>
      </div>
