                    <path class="p2" pathLength="1" d={['M12 31 C 70 25, 130 33, 228 19', 'M10 27 C 80 20, 160 30, 230 23', 'M8 30 C 90 23, 150 28, 232 24', 'M14 26 C 70 31, 170 19, 230 28', 'M9 31 C 85 22, 150 31, 231 22', 'M11 28 C 75 22, 165 31, 229 21'][i]} />
