{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "sequential-calls": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Miscellaneous",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='ferrule-converter' || @.name.value=='ferrule-csharp-plugin' || @.name.value=='ferrule-gen' || @.name.value=='ferrule-go-plugin' || @.name.value=='ferrule-jvm-plugin' || @.name.value=='ferrule-php-plugin' || @.name.value=='ferrule-python-plugin' || @.name.value=='ferrule-ruby-plugin' || @.name.value=='ferrule-rust-plugin' || @.name.value=='ferrule-sdk-model' || @.name.value=='ferrule-ts-plugin')].version"
        },
        {
          "type": "toml",
          "path": "migrate/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "runtime/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='ferrule' || @.name.value=='ferrule-runtime')].version"
        }
      ]
    }
  }
}
