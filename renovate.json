{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":pinDevDependencies"],
  "schedule": ["before 6am on monday"],
  "timezone": "Etc/UTC",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "commitBody": "Signed-off-by: {{{gitAuthor}}}",
  "prConcurrentLimit": 5,
  "dependencyDashboard": true,
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] },
  "vulnerabilityAlerts": { "enabled": true, "schedule": ["at any time"] },
  "ignorePaths": [
    "**/node_modules/**",
    ".cache/**",
    "oracles/cache/**",
    "corpus/cache/**",
    "python-plugin/test/golden/**"
  ],
  "packageRules": [
    {
      "description": "GitHub Actions: one weekly PR, digests pinned with version comments",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "semanticCommitType": "ci"
    },
    {
      "description": "Node dependencies grouped weekly",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "node non-major"
    },
    {
      "description": "Python dependencies grouped weekly",
      "matchManagers": ["pep621", "pep735"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python non-major"
    },
    {
      "description": "Toolchain in mise.toml grouped weekly",
      "matchManagers": ["mise"],
      "groupName": "toolchain"
    },
    {
      "description": "Forge is pinned to a git commit in scripts/forge-setup.sh. forge-canary.yml tests latest weekly; bump the pin by hand after a green canary.",
      "matchPackageNames": ["/forge/i"],
      "enabled": false
    },
    {
      "description": "Never touch the Forge pin script or oracle/corpus pins",
      "matchFileNames": ["scripts/forge-setup.sh", "oracles/**", "corpus/**"],
      "enabled": false
    }
  ]
}
