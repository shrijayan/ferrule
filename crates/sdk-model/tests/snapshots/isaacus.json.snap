            "wire_name": "pinpoints",
            "required": true,
            "deprecated": false,
            "read_only": false,
            "description": "An array of spans within the document's text where specific parts of the external document are referenced, for example, 'Section 2' in 'as defined in Section 2 of the US Constitution'.",
            "default": null,
            "ty": {
              "kind": "array",
              "items": {
                "kind": "ref",
                "schema": "ILGSv1 Span",
                "path": [
                  {"written": "ilgs", "words": ["ilgs"]},
