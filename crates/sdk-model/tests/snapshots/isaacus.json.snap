          ],
          "order": 0,
          "methods": [
            {
              "name": {"written": "create", "words": ["create"]},
              "pointer": "#/paths/~1classifications~1universal/post",
              "http_method": "post",
              "path": "/classifications/universal",
              "summary": "Universal classification",
              "description": "Classify documents with an Isaacus universal classification model.",
              "order": 0,
              "deprecated": false,
              "path_params": [],
              "query_params": [],
              "header_params": [],
              "body": {
                "media_type": "application/json",
                "required": true,
                "description": "",
                "schema_description": "A request to classify the relevance of documents to a query with an Isaacus universal classification model.",
                "ty": {
                  "kind": "object",
                  "bases": [],
                  "fields": [
                    {
                      "name": {"written": "chunking_options", "words": ["chunking", "options"]},
                      "wire_name": "chunking_options",
                      "required": false,
                      "deprecated": false,
                      "read_only": false,
                      "description": "Settings for how the texts should be chunked into smaller segments before classification using [semchunk](https://github.com/isaacus-dev/semchunk).\n\nIf `null`, the texts will not be chunked and will instead be truncated to the maximum input length of the model less overhead if found to exceed that limit.\n\nChunking is enabled by default.",
                      "default": null,
                      "ty": {
                        "kind": "nullable",
                        "inner": {
                          "kind": "object",
                          "bases": [],
                          "fields": [
                            {
                              "name": {"written": "overlap_ratio", "words": ["overlap", "ratio"]},
                              "wire_name": "overlap_ratio",
                              "required": false,
                              "deprecated": false,
                              "read_only": false,
                              "description": "The proportion of the chunk size by which chunks should overlap.\n\nThe ratio must be less than 1.\n\nIf `null`, no overlapping will occur unless `overlap_tokens` is set.\n\n`overlap_ratio` and `overlap_tokens` cannot both be set.",
                              "default": null,
                              "ty": {
                                "kind": "nullable",
                                "inner": {"kind": "scalar", "scalar": "double"}
                              }
                            },
                            {
                              "name": {"written": "overlap_tokens", "words": ["overlap", "tokens"]},
                              "wire_name": "overlap_tokens",
                              "required": false,
                              "deprecated": false,
                              "read_only": false,
                              "description": "The number of tokens by which chunks should overlap.\n\nIf `null`, no overlapping will occur unless `overlap_ratio` is set.\n\n`overlap_tokens` and `overlap_ratio` cannot both be set.",
                              "default": null,
                              "ty": {
                                "kind": "nullable",
                                "inner": {"kind": "scalar", "scalar": "int"}
                              }
                            },
                            {
                              "name": {"written": "size", "words": ["size"]},
                              "wire_name": "size",
                              "required": false,
                              "deprecated": false,
                              "read_only": false,
                              "description": "The maximum number of tokens allowed in a chunk.\n\nIf `null`, the maximum input length of the model will be used less overhead.",
                              "default": null,
                              "ty": {
                                "kind": "nullable",
                                "inner": {"kind": "scalar", "scalar": "int"}
                              }
                            }
                          ],
                          "extra": null,
                          "description": "Options for how to split text into smaller chunks.",
                          "origin": "ChunkingOptions"
                        }
                      }
                    },
                    {
                      "name": {"written": "is_iql", "words": ["is", "iql"]},
                      "wire_name": "is_iql",
                      "required": false,
                      "deprecated": false,
                      "read_only": false,
                      "description": "Whether the query should be interpreted as an [IQL](https://docs.isaacus.com/iql) query or else as a statement.",
                      "default": true,
                      "ty": {"kind": "scalar", "scalar": "boolean"}
                    },
                    {
                      "name": {"written": "model", "words": ["model"]},
                      "wire_name": "model",
                      "required": true,
                      "deprecated": false,
                      "read_only": false,
                      "description": "The ID of the [model](https://docs.isaacus.com/models#universal-classification) to use for universal classification.",
                      "default": null,
                      "ty": {
                        "kind": "enum",
                        "members": [
                          {
                            "value": "kanon-universal-classifier",
                            "name": {
                              "written": "kanon-universal-classifier",
                              "words": ["kanon", "universal", "classifier"]
                            }
                          }
                        ]
                      }
                    },
                    {
                      "name": {"written": "query", "words": ["query"]},
                      "wire_name": "query",
                      "required": true,
                      "deprecated": false,
                      "read_only": false,
                      "description": "The [Isaacus Query Language (IQL)](https://docs.isaacus.com/iql) query or, if IQL is disabled, the statement, to evaluate the texts against.\n\nThe query must contain at least one non-whitespace character.\n\nUnlike the texts being classified, the query cannot be so long that it exceeds the maximum input length of the universal classifier.",
                      "default": null,
                      "ty": {"kind": "scalar", "scalar": "string"}
                    },
                    {
                      "name": {"written": "scoring_method", "words": ["scoring", "method"]},
                      "wire_name": "scoring_method",
                      "required": false,
                      "deprecated": false,
                      "read_only": false,
                      "description": "The method to use for producing an overall confidence score.\n\n`auto` is the default scoring method and is recommended for most use cases. Currently, it is equivalent to `chunk_max`. In the future, it will automatically select the best method based on the model and inputs.\n\n`chunk_max` uses the highest confidence score of all of the texts' chunks.\n\n`chunk_avg` averages the confidence scores of all of the texts' chunks.\n\n`chunk_min` uses the lowest confidence score of all of the texts' chunks.",
                      "default": "auto",
                      "ty": {
                        "kind": "enum",
                        "members": [
                          {"value": "auto", "name": {"written": "auto", "words": ["auto"]}},
                          {
                            "value": "chunk_max",
                            "name": {"written": "chunk_max", "words": ["chunk", "max"]}
                          },
                          {
                            "value": "chunk_avg",
                            "name": {"written": "chunk_avg", "words": ["chunk", "avg"]}
                          },
                          {
                            "value": "chunk_min",
                            "name": {"written": "chunk_min", "words": ["chunk", "min"]}
                          }
                        ]
                      }
                    },
                    {
                      "name": {"written": "texts", "words": ["texts"]},
                      "wire_name": "texts",
                      "required": true,
                      "deprecated": false,
                      "read_only": false,
                      "description": "The texts to classify.\n\nEach text must contain at least one non-whitespace character.",
                      "default": null,
                      "ty": {"kind": "array", "items": {"kind": "scalar", "scalar": "string"}}
                    }
                  ],
                  "extra": null,
                  "description": "A request to classify the relevance of documents to a query with an Isaacus universal classification model.",
                  "origin": "UniversalClassificationRequest"
                }
              },
              "response": {
                "status": "200",
                "media_type": "application/json",
                "ty": {
                  "kind": "ref",
                  "schema": "UniversalClassificationResponse",
                  "path": [
                    {"written": "classifications", "words": ["classifications"]},
                    {"written": "universal", "words": ["universal"]},
                    {
                      "written": "universal_classification_response",
                      "words": ["universal", "classification", "response"]
                    }
                  ],
                  "name": {
                    "written": "UniversalClassificationResponse",
                    "words": ["universal", "classification", "response"]
                  }
                }
              },
              "pagination": null,
              "streaming": null
            }
          ],
          "subresources": [],
          "standalone": true
        }
      ],
      "standalone": false
    },
