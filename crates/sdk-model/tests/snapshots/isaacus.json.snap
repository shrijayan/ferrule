            "ty": {
              "kind": "object",
              "bases": [],
              "fields": [
                {
                  "name": {"written": "dimensions", "words": ["dimensions"]},
                  "wire_name": "dimensions",
                  "required": false,
                  "deprecated": false,
                  "read_only": false,
                  "description": "The number of dimensions the embeddings should have, not exceeding the maximum dimensions of the model.\n\nIf `null`, the model's default dimensions will be used.",
                  "default": null,
                  "ty": {"kind": "nullable", "inner": {"kind": "scalar", "scalar": "int"}}
                },
                {
                  "name": {"written": "model", "words": ["model"]},
                  "wire_name": "model",
                  "required": true,
                  "deprecated": false,
                  "read_only": false,
                  "description": "The ID of the [model](https://docs.isaacus.com/models#embedding) to use for embedding.",
                  "default": null,
                  "ty": {
                    "kind": "enum",
                    "members": [
                      {
                        "value": "kanon-2-embedder",
                        "name": {
                          "written": "kanon-2-embedder",
                          "words": ["kanon", "2", "embedder"]
                        }
                      }
                    ]
                  }
                },
                {
                  "name": {"written": "overflow_strategy", "words": ["overflow", "strategy"]},
                  "wire_name": "overflow_strategy",
                  "required": false,
                  "deprecated": false,
                  "read_only": false,
                  "description": "The strategy to employ when content exceeds the model's maximum input length.\n\n`drop_end`, which is the default setting, drops tokens from the end of the content exceeding the limit.\n\nIf `null`, an error will be raised if any content exceeds the model's maximum input length.",
                  "default": "drop_end",
                  "ty": {
                    "kind": "nullable",
                    "inner": {
                      "kind": "enum",
                      "members": [
                        {
                          "value": "drop_end",
                          "name": {"written": "drop_end", "words": ["drop", "end"]}
                        }
                      ]
                    }
                  }
                },
                {
                  "name": {"written": "task", "words": ["task"]},
                  "wire_name": "task",
                  "required": false,
                  "deprecated": false,
                  "read_only": false,
                  "description": "The task the embeddings will be used for.\n\n`retrieval/query` is meant for queries and statements, and `retrieval/document` is meant for anything to be retrieved using query embeddings.\n\nIf `null`, which is the default setting, embeddings will not be optimized for any particular task.",
                  "default": null,
                  "ty": {
                    "kind": "nullable",
                    "inner": {
                      "kind": "enum",
                      "members": [
                        {
                          "value": "retrieval/query",
                          "name": {"written": "retrieval/query", "words": ["retrieval", "query"]}
                        },
                        {
                          "value": "retrieval/document",
                          "name": {
                            "written": "retrieval/document",
                            "words": ["retrieval", "document"]
                          }
                        }
                      ]
                    }
                  }
                },
