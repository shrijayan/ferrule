                "name": {"written": "Span", "words": ["span"]}
              }
            }
          },
          {
            "name": {"written": "reception", "words": ["reception"]},
            "wire_name": "reception",
            "required": true,
            "deprecated": false,
            "read_only": false,
            "description": "The sentiment of the document towards the external document, being one of `positive`, `mixed`, `negative`, or `neutral`.\n\n`positive` indicates that the document expresses a favorable view of the external document whether by endorsing or approving it.\n\n`mixed` indicates that the document expresses both favorable and unfavorable views of the external document, for example, by affirming parts of it and disapproving others.\n\n`negative` indicates that the document expresses an unfavorable view of the external document whether by criticizing, repealing, overruling, or explicitly contradicting it.\n\n`neutral` indicates that the document references the external document without expressing any particular sentiment towards it.",
            "default": null,
            "ty": {
              "kind": "enum",
              "members": [
                {"value": "positive", "name": {"written": "positive", "words": ["positive"]}},
                {"value": "mixed", "name": {"written": "mixed", "words": ["mixed"]}},
                {"value": "negative", "name": {"written": "negative", "words": ["negative"]}},
                {"value": "neutral", "name": {"written": "neutral", "words": ["neutral"]}}
              ]
            }
