      },
      "description": "A segment within the document representing a structurally distinct portion of the document's content.",
      "deprecated": false,
      "ty": {
        "kind": "object",
        "bases": [],
        "fields": [
          {
            "name": {"written": "category", "words": ["category"]},
            "wire_name": "category",
            "required": true,
            "deprecated": false,
            "read_only": false,
            "description": "The functional 'category' of the segment within the document, being one of `front_matter`, `scope`, `main`, `annotation`, `back_matter`, or `other`.\n\n`front_matter` denotes non-operative contextualizing content occurring at the start of a document such as a preamble or recitals.\n\n`scope` denotes operative content defining the application or interpretation of a document such as definition sections and governing law clauses.\n\n`main` denotes operative, non-scopal content.\n\n`annotation` denotes non-operative annotative content providing explanatory or referential information such as commentary, footnotes, and endnotes.\n\n`back_matter` denotes non-operative contextualizing content occurring at the end of a document such as authority statements.\n\n`other` denotes content that does not fit into any of the other categories.",
            "default": null,
            "ty": {
              "kind": "enum",
              "members": [
                {
                  "value": "front_matter",
                  "name": {"written": "front_matter", "words": ["front", "matter"]}
                },
                {"value": "scope", "name": {"written": "scope", "words": ["scope"]}},
                {"value": "main", "name": {"written": "main", "words": ["main"]}},
                {"value": "annotation", "name": {"written": "annotation", "words": ["annotation"]}},
                {
                  "value": "back_matter",
                  "name": {"written": "back_matter", "words": ["back", "matter"]}
                },
                {"value": "other", "name": {"written": "other", "words": ["other"]}}
              ]
            }
          },
          {
            "name": {"written": "children", "words": ["children"]},
            "wire_name": "children",
            "required": true,
            "deprecated": false,
            "read_only": false,
