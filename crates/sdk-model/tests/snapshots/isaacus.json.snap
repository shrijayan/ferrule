          "query_params": [],
          "header_params": [],
          "body": {
            "media_type": "application/json",
            "required": true,
            "description": "",
            "schema_description": "A request to rerank documents by their relevance to a query with an Isaacus reranker.",
            "ty": {
              "kind": "object",
              "bases": [],
              "fields": [
                {
                  "name": {"written": "chunking_options", "words": ["chunking", "options"]},
                  "wire_name": "chunking_options",
                  "required": false,
                  "deprecated": false,
                  "read_only": false,
                  "description": "Settings for how texts should be chunked into smaller segments by [semchunk](https://github.com/isaacus-dev/semchunk) before reranking.\n\nIf `null`, the texts will not be chunked and will instead be truncated to the maximum input length of the reranker less overhead if found to exceed that limit.\n\nChunking is enabled by default.",
                  "default": null,
                  "ty": {
                    "kind": "nullable",
                    "inner": {
                      "kind": "object",
                      "bases": [],
                      "fields": [
                        {
                          "name": {"written": "overlap_ratio", "words": ["overlap", "ratio"]},
                          "wire_name": "overlap_ratio",
                          "required": false,
                          "deprecated": false,
                          "read_only": false,
                          "description": "The proportion of the chunk size by which chunks should overlap.\n\nThe ratio must be less than 1.\n\nIf `null`, no overlapping will occur unless `overlap_tokens` is set.\n\n`overlap_ratio` and `overlap_tokens` cannot both be set.",
                          "default": null,
                          "ty": {
                            "kind": "nullable",
                            "inner": {"kind": "scalar", "scalar": "double"}
                          }
                        },
                        {
                          "name": {"written": "overlap_tokens", "words": ["overlap", "tokens"]},
                          "wire_name": "overlap_tokens",
                          "required": false,
                          "deprecated": false,
                          "read_only": false,
                          "description": "The number of tokens by which chunks should overlap.\n\nIf `null`, no overlapping will occur unless `overlap_ratio` is set.\n\n`overlap_tokens` and `overlap_ratio` cannot both be set.",
                          "default": null,
                          "ty": {"kind": "nullable", "inner": {"kind": "scalar", "scalar": "int"}}
                        },
                        {
                          "name": {"written": "size", "words": ["size"]},
                          "wire_name": "size",
                          "required": false,
                          "deprecated": false,
                          "read_only": false,
                          "description": "The maximum number of tokens allowed in a chunk.\n\nIf `null`, the maximum input length of the model will be used less overhead.",
                          "default": null,
                          "ty": {"kind": "nullable", "inner": {"kind": "scalar", "scalar": "int"}}
                        }
                      ],
                      "extra": null,
                      "description": "Options for how to split text into smaller chunks.",
                      "origin": "ChunkingOptions"
                    }
                  }
                },
                {
                  "name": {"written": "is_iql", "words": ["is", "iql"]},
                  "wire_name": "is_iql",
                  "required": false,
                  "deprecated": false,
                  "read_only": false,
                  "description": "Whether the query should be interpreted as an [Isaacus Query Language (IQL)](https://docs.isaacus.com/iql) query, which is not the case by default.\n\nIf you allow untrusted users to construct their own queries, think carefully before enabling IQL since queries can be crafted to consume an excessively large amount of tokens.",
                  "default": false,
                  "ty": {"kind": "scalar", "scalar": "boolean"}
                },
                {
                  "name": {"written": "model", "words": ["model"]},
                  "wire_name": "model",
                  "required": true,
                  "deprecated": false,
                  "read_only": false,
                  "description": "The ID of the model to use for reranking, being either a [reranking model](https://docs.isaacus.com/models/introduction#reranking) or [universal classification model](https://docs.isaacus.com/models/introduction#universal-classification).",
                  "default": null,
                  "ty": {
                    "kind": "enum",
                    "members": [
                      {
                        "value": "kanon-2-reranker",
                        "name": {
                          "written": "kanon-2-reranker",
                          "words": ["kanon", "2", "reranker"]
                        }
                      },
                      {
                        "value": "kanon-universal-classifier",
                        "name": {
                          "written": "kanon-universal-classifier",
                          "words": ["kanon", "universal", "classifier"]
                        }
                      }
                    ]
                  }
                },
                {
                  "name": {"written": "query", "words": ["query"]},
                  "wire_name": "query",
                  "required": true,
                  "deprecated": false,
                  "read_only": false,
                  "description": "The query to evaluate the relevance of the texts to.\n\nThe query must contain at least one non-whitespace character.\n\nUnlike the texts being reranked, the query cannot be so long that it exceeds the maximum input length of the reranker.",
                  "default": null,
                  "ty": {"kind": "scalar", "scalar": "string"}
                },
                {
                  "name": {"written": "scoring_method", "words": ["scoring", "method"]},
                  "wire_name": "scoring_method",
                  "required": false,
                  "deprecated": false,
                  "read_only": false,
                  "description": "The method to use for producing an overall relevance score for a text that exceeds the model's local context window and has, therefore, been split into multiple chunks.\n\n`auto` is the default scoring method and is recommended for most use cases. Currently, it is equivalent to `chunk_max`. In the future, it will automatically select the best method based on the model and inputs.\n\n`chunk_max` uses the highest relevance score of all of a text's chunks.\n\n`chunk_avg` averages the relevance scores of all of a text's chunks.\n\n`chunk_min` uses the lowest relevance score of all of a text's chunks.",
                  "default": "auto",
                  "ty": {
                    "kind": "enum",
                    "members": [
                      {"value": "auto", "name": {"written": "auto", "words": ["auto"]}},
                      {
                        "value": "chunk_max",
                        "name": {"written": "chunk_max", "words": ["chunk", "max"]}
                      },
                      {
                        "value": "chunk_avg",
                        "name": {"written": "chunk_avg", "words": ["chunk", "avg"]}
                      },
                      {
                        "value": "chunk_min",
                        "name": {"written": "chunk_min", "words": ["chunk", "min"]}
                      }
                    ]
                  }
                },
                {
                  "name": {"written": "texts", "words": ["texts"]},
                  "wire_name": "texts",
                  "required": true,
                  "deprecated": false,
                  "read_only": false,
                  "description": "The texts to rerank.\n\nThere must be at least one text.\n\nEach text must contain at least one non-whitespace character.",
                  "default": null,
                  "ty": {"kind": "array", "items": {"kind": "scalar", "scalar": "string"}}
                },
                {
                  "name": {"written": "top_n", "words": ["top", "n"]},
                  "wire_name": "top_n",
                  "required": false,
                  "deprecated": false,
                  "read_only": false,
                  "description": "The number of highest scoring results to return.\n\nIf `null`, which is the default, all results will be returned.",
                  "default": null,
                  "ty": {"kind": "nullable", "inner": {"kind": "scalar", "scalar": "int"}}
                }
              ],
              "extra": null,
              "description": "A request to rerank documents by their relevance to a query with an Isaacus reranker.",
              "origin": "RerankingRequest"
            }
