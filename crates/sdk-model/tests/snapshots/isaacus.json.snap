            "ty": {"kind": "scalar", "scalar": "int"}
          },
          {
            "name": {"written": "parent", "words": ["parent"]},
            "wire_name": "parent",
            "required": true,
            "deprecated": false,
            "read_only": false,
            "description": "The unique identifier of the 'parent' segment immediately containing this segment or `null` if the segment has no parent (i.e., it is a root-level segment).\n\nA segment with the `container` kind can be the parent of segments of any kind, including other `container`s.\n\nA segment with the `unit` kind can only be the parent of `item`s and `figure`s.\n\nA segment with the `item` kind can only be the parent of other `item`s.\n\nA segment with the `figure` kind cannot be the parent of any segments.",
            "default": null,
            "ty": {"kind": "nullable", "inner": {"kind": "scalar", "scalar": "string"}}
