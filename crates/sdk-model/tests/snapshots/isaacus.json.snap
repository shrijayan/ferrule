            "required": true,
            "deprecated": false,
            "read_only": false,
            "description": "The unique identifier of the legal person that this date is associated with or `null` if the date is not associated with any legal person.\n\nFor `birth` and `death` dates, this field will always be populated.",
            "default": null,
            "ty": {"kind": "nullable", "inner": {"kind": "scalar", "scalar": "string"}}
