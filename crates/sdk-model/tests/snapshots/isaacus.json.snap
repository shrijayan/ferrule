{
  "package": {"name": "isaacus", "repo": "isaacus-dev/isaacus-python"},
  "version": "0.8.3",
  "description": "Isaacus API\n\nA RESTful API for using Isaacus legal models, data and other solutions.",
  "base_url": "https://api.isaacus.com/v1",
  "settings": {
    "name": {"written": "isaacus", "words": ["isaacus"]},
    "env_prefix": "ISAACUS",
    "opts": [
      {
        "name": {"written": "api_key", "words": ["api", "key"]},
        "ty": "string",
        "nullable": false,
        "default": null,
        "read_env": "ISAACUS_API_KEY",
        "description": "An Isaacus-issued API key passed as a bearer token via the `Authorization` header.",
        "auth": {"security_scheme": "APIKeyBearerTokenAuth", "role": "value"},
        "send": null
      }
    ],
    "environments": [
      {
        "name": {"written": "production", "words": ["production"]},
        "url": "https://api.isaacus.com/v1"
      }
    ],
    "default_environment": "production",
    "security_schemes": [
      {
        "name": "APIKeyBearerTokenAuth",
        "scheme": {"type": "http", "scheme": "bearer", "keyword": null}
      }
    ],
    "security": [["APIKeyBearerTokenAuth"]],
    "timeout_seconds": 60.0,
    "max_retries": 2,
    "initial_retry_delay_seconds": 0.5,
    "max_retry_delay_seconds": 8.0,
    "idempotency_header": null,
    "default_headers": [],
    "array_format": "comma",
    "nested_format": "brackets"
  },
  "casings": [
    {"word": "ilgs", "casing": {"initialism": true}},
    {"word": "qa", "casing": {"initialism": true}},
    {"word": "v1", "casing": {"pascal": "v1"}}
  ],
  "resources": [
