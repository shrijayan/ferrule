# From OneBusAway/java-sdk @ c29c48ad and OneBusAway/kotlin-sdk @ 69234467, scripts/lint (Apache-2.0, see NOTICE). Modified by The Ferrule Authors: names replaced by {{...}} tokens, the flavors merged with {{#java}} blocks, branding per BRANDING.md; this line is not emitted.
#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

{{#java}}
echo "==> Running lints"

{{/java}}
if command -v ktfmt &> /dev/null; then
    echo "==> Checking ktfmt"
{{#java}}
    ./scripts/kotlin-format --dry-run --set-exit-if-changed
{{/java}}
{{#kotlin}}
    ./scripts/format --dry-run --set-exit-if-changed
{{/kotlin}}
else
{{#java}}
    echo "==> Running gradlew lintKotlin"
    ./gradlew lintKotlin
{{/java}}
{{#kotlin}}
    echo "==> Running gradlew lint"
    ./gradlew lint
{{/kotlin}}
fi

{{#java}}
if command -v palantir-java-format &> /dev/null; then
    echo "==> Checking palantir-java-format"
    ./scripts/java-format --dry-run --set-exit-if-changed
else
    echo "==> Running gradlew lintJava"
    ./gradlew lintJava
fi

{{/java}}