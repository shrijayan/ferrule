{
  "sha256": "85b65165e938aedcf3239357af8c79fc22ece7257648f8884a99e64336e30f17",
  "root": {
    "x-ferrule-client": {
      "defaultEnvironment": "production",
      "defaultHeaders": {},
      "envPrefix": "IMAGE_KIT",
      "environments": [
        {
          "name": "production",
          "url": "https://api.imagekit.io"
        }
      ],
      "name": "ImageKit",
      "omitPlatformHeaders": false,
      "opts": [
        {
          "auth": {
            "role": "username",
            "securityScheme": "basicAuth"
          },
          "description": "Your ImageKit private API key (starts with `private_`).\nYou can find this in the [ImageKit dashboard](https://imagekit.io/dashboard/developer/api-keys).\n",
          "name": "private_key",
          "nullable": false,
          "readEnv": "IMAGEKIT_PRIVATE_KEY",
          "type": "string"
        },
        {
          "auth": {
            "role": "password",
            "securityScheme": "basicAuth"
          },
          "default": "do_not_set",
          "description": "ImageKit uses your API key as username and ignores the password. \nThe SDK sets a dummy value. You can ignore this field.\n",
          "name": "password",
          "nullable": true,
          "readEnv": "OPTIONAL_IMAGEKIT_IGNORES_THIS",
          "type": "string"
        },
        {
          "description": "Your ImageKit webhook secret for verifying webhook signatures (starts with `whsec_`).\nYou can find this in the [ImageKit dashboard](https://imagekit.io/dashboard/developer/webhooks).\nOnly required if you're using webhooks.\n",
          "name": "webhook_secret",
          "nullable": true,
          "readEnv": "IMAGEKIT_WEBHOOK_SECRET",
          "type": "string"
        }
      ],
      "query": {
        "arrayFormat": "comma",
        "nestedFormat": "brackets"
      },
      "retries": {
        "initialDelaySeconds": 0.5,
        "maxDelaySeconds": 8,
        "maxRetries": 2
      },
      "security": [
        {
          "basicAuth": []
        }
      ],
      "securitySchemes": {
        "basicAuth": {
          "disableBase64": false,
          "scheme": "basic",
          "type": "http"
        }
      },
      "timeoutSeconds": 60
    },
    "x-ferrule-targets": {
      "csharp": {
        "edition": "csharp.2025-10-08",
        "options": {},
        "package_name": "Imagekit",
        "production_repo": "imagekit-developer/imagekit-dotnet#master"
      },
      "python": {
        "edition": "python.2025-10-08",
        "options": {
          "options": {
            "use_uv": false
          }
        }
      }
    }
  },
