  "sha256": "163ad50afc31306f00a49329b46fed7f2d1431a8093b63a7ad184d9cca88981e",
  "root": {
    "x-ferrule-client": {
      "defaultEnvironment": "production",
      "defaultHeaders": {},
      "envPrefix": "STAGEHAND",
      "environments": [
        {
          "name": "production",
          "url": "https://api.stagehand.browserbase.com"
        }
      ],
      "name": "stagehand",
      "omitPlatformHeaders": false,
      "opts": [
        {
          "auth": {
            "role": "value",
            "securityScheme": "BBApiKeyAuth"
          },
          "description": "Your [Browserbase API Key](https://www.browserbase.com/settings)",
          "name": "BROWSERBASE_API_KEY",
          "nullable": false,
          "readEnv": "BROWSERBASE_API_KEY",
          "type": "string"
        },
        {
          "auth": {
            "role": "value",
            "securityScheme": "BBProjectIdAuth"
          },
          "description": "Deprecated. Browserbase API keys are now project-scoped, so this value is no longer required.",
          "name": "BROWSERBASE_PROJECT_ID",
          "nullable": true,
          "readEnv": "BROWSERBASE_PROJECT_ID",
          "type": "string"
        },
        {
          "auth": {
            "role": "value",
            "securityScheme": "LLMModelApiKeyAuth"
          },
          "description": "Your LLM provider API key (e.g. OPENAI_API_KEY, ANTHROPIC_API_KEY, etc.)",
          "name": "MODEL_API_KEY",
          "nullable": false,
          "readEnv": "MODEL_API_KEY",
          "type": "string"
        }
      ],
      "query": {
        "arrayFormat": "comma",
        "nestedFormat": "brackets"
      },
      "retries": {
        "initialDelaySeconds": 0.5,
        "maxDelaySeconds": 8,
        "maxRetries": 2
      },
      "security": [
        {
          "BBApiKeyAuth": [],
          "BBProjectIdAuth": [],
          "LLMModelApiKeyAuth": []
        }
      ],
      "securitySchemes": {
        "BBApiKeyAuth": {
          "in": "header",
          "name": "x-bb-api-key",
          "type": "apiKey"
        },
        "BBProjectIdAuth": {
          "in": "header",
          "name": "x-bb-project-id",
          "type": "apiKey"
        },
        "BrowserbaseApiKey": {
          "in": "header",
          "name": "x-bb-api-key",
          "type": "apiKey"
        },
        "BrowserbaseProjectId": {
          "in": "header",
          "name": "x-bb-project-id",
          "type": "apiKey"
        },
        "LLMModelApiKeyAuth": {
          "in": "header",
          "name": "x-model-api-key",
          "type": "apiKey"
        },
        "ModelApiKey": {
          "in": "header",
          "name": "x-model-api-key",
          "type": "apiKey"
        }
      },
      "timeoutSeconds": 60
    },
    "x-ferrule-config": {
      "edition": "2025-10-10",
      "packageName": "stagehand",
      "projectName": "stagehand",
      "pythonEdition": "python.2025-11-20",
