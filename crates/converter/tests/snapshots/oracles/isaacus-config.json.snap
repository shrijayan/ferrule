    "x-ferrule-client": {
      "defaultEnvironment": "production",
      "defaultHeaders": {},
      "envPrefix": "ISAACUS",
      "environments": [
        {
          "name": "production",
          "url": "https://api.isaacus.com/v1"
        }
      ],
      "name": "isaacus",
      "omitPlatformHeaders": false,
      "opts": [
        {
          "auth": {
            "role": "value",
            "securityScheme": "APIKeyBearerTokenAuth"
          },
          "description": "An Isaacus-issued API key passed as a bearer token via the `Authorization` header.",
          "name": "api_key",
          "nullable": false,
          "readEnv": "ISAACUS_API_KEY",
          "type": "string"
        }
      ],
      "query": {
        "arrayFormat": "comma",
        "nestedFormat": "brackets"
      },
      "retries": {
        "initialDelaySeconds": 0.5,
        "maxDelaySeconds": 8,
        "maxRetries": 2
      },
      "security": [
        {
          "APIKeyBearerTokenAuth": []
        }
      ],
      "securitySchemes": {
        "APIKeyBearerTokenAuth": {
          "scheme": "bearer",
          "type": "http"
        }
      },
      "timeoutSeconds": 60
    },
