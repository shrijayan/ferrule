  "root": {
    "x-ferrule-client": {
      "defaultEnvironment": "production",
      "defaultHeaders": {},
      "envPrefix": "OGX_CLIENT",
      "environments": [
        {
          "name": "production",
          "url": "http://any-hosted-ogx.com"
        }
      ],
      "name": "ogx-client",
      "omitPlatformHeaders": false,
      "opts": [
        {
          "auth": {
            "role": "value",
            "securityScheme": "BearerAuth"
          },
          "name": "api_key",
          "nullable": true,
          "readEnv": "OGX_CLIENT_API_KEY",
          "type": "string"
        }
      ],
      "query": {
        "arrayFormat": "comma",
        "nestedFormat": "brackets"
      },
      "retries": {
        "initialDelaySeconds": 0.5,
        "maxDelaySeconds": 8,
        "maxRetries": 2
      },
      "security": [
        {},
        {
          "BearerAuth": []
        }
      ],
      "securitySchemes": {
        "BearerAuth": {
          "scheme": "bearer",
          "type": "http"
        }
      },
      "timeoutSeconds": 60
    },
    "x-ferrule-config": {
      "edition": "2025-10-08",
      "packageName": "ogx_client",
      "projectName": "ogx_client",
      "pythonEdition": "python.2025-10-08",
      "version": 1
    },
    "x-ferrule-page-schemes": [
      {
        "className": "OpenaiCursorPage",
        "kind": "cursor",
        "name": "openai_cursor_page",
        "request": [
          {
            "name": "limit",
            "type": "integer"
          },
          {
            "name": "after",
            "purpose": "next_cursor_param",
            "type": "string"
          }
        ],
        "response": [
          {
            "name": "data",
            "purpose": "items",
            "type": "array"
          },
          {
            "name": "has_more",
            "type": "boolean"
          },
          {
            "name": "last_id",
            "purpose": "next_cursor_field",
            "type": "string"
          }
        ]
      }
    ],
    "x-ferrule-targets": {
      "go": {
        "edition": "go.2025-10-08",
