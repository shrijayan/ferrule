          "source": "from openai import OpenAI\n\nclient = OpenAI(base_url=\"http://localhost:8321/v1\", api_key=\"fake\")\n\nmodel = client.models.retrieve(\"meta-llama/Llama-3.1-8B-Instruct\")\nprint(model)"
