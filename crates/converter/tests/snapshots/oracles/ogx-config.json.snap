    "POST /v1/messages": {
      "x-codeSamples": [
        {
          "label": "Anthropic",
          "lang": "Anthropic",
          "source": "from anthropic import Anthropic\n\nclient = Anthropic(\n    base_url=\"http://localhost:8321/v1\",\n    api_key=\"fake\",\n)\n\nmessage = client.messages.create(\n    model=\"llama-3.3-70b\",\n    max_tokens=1024,\n    messages=[\n        {\"role\": \"user\", \"content\": \"What is OGX?\"}\n    ],\n)\n\nprint(message.content[0].text)"
        }
      ]
    },
