          "label": "OpenAI",
          "lang": "OpenAI",
          "source": "from openai import OpenAI\n\nclient = OpenAI(base_url=\"http://localhost:8321/v1\", api_key=\"fake\")\n\nbatches = client.batches.list()\nfor batch in batches:\n    print(batch.id, batch.status)"
