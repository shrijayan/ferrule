{
  "name": "@ferrule/python-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/plugin.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "build": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && forge-plugin build src/plugin.ts -o dist/plugin.wasm",
    "golden": "node scripts/golden.ts"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "1.39.0",
    "@cloudflare/forge": "link:../.cache/forge/packages/forge",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
